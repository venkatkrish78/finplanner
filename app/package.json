{
  "name": "finplanner",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node migrate-and-start.js",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "auth:setup": "echo 'Setting up authentication...' && npm run db:generate && npm run db:push",
    "db:reset-auth": "prisma migrate reset --force && npm run db:seed",
    "dev:auth": "echo 'Starting with auth enabled...' && npm run dev",
    "check:auth": "echo 'Checking authentication setup...' && node -e \"console.log('NextAuth configured:', !!process.env.NEXTAUTH_SECRET)\"",
    "seed": "tsx seed-demo-data.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "6.10.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.7",
    "ai": "^4.3.16",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "0.522.0",
    "next": "15.3.4",
    "next-auth": "4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^5.6.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "9.7.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.52.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8.5.6",
    "prisma": "6.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
